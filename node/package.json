{
  "name": "@si-rvp/node",
  "version": "0.1.0",
  "description": "Off-chain components for SI-RVP: sequencer, challenger, prover, bisection P2P transport",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start:sequencer": "ts-node src/sequencer/index.ts",
    "start:challenger": "ts-node src/challenger/index.ts",
    "demo": "ts-node src/demo.ts",
    "demo:happy": "ts-node src/scripts/demo-scenario.ts happy_path 20",
    "demo:dispute-early": "ts-node src/scripts/demo-scenario.ts dispute_early 50",
    "demo:dispute-late": "ts-node src/scripts/demo-scenario.ts dispute_late 100",
    "demo:compare": "ts-node src/scripts/demo-scenario.ts dispute_early 50 --compare",
    "export:dashboard": "mkdir -p public/data && ts-node src/scripts/export-dashboard-data.ts all > public/data/scenarios.json",
    "dashboard": "npm run export:dashboard && python3 -m http.server 8080 -d public",
    "e2e:onchain": "ts-node src/scripts/onchain-e2e.ts",
    "e2e:export": "mkdir -p public/data && ts-node src/scripts/onchain-e2e.ts",
    "test": "TS_NODE_PROJECT=tsconfig.test.json mocha -r ts-node/register test/**/*.test.ts --timeout 60000",
    "test:e2e": "TS_NODE_PROJECT=tsconfig.test.json mocha -r ts-node/register test/e2e.test.ts --timeout 60000",
    "coverage": "TS_NODE_PROJECT=tsconfig.test.json nyc mocha -r ts-node/register test/**/*.test.ts --timeout 60000"
  },
  "dependencies": {
    "circomlibjs": "^0.1.7",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "snarkjs": "^0.7.3",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/sinon": "^21.0.0",
    "@types/ws": "^8.5.10",
    "c8": "^10.1.3",
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "nyc": "^17.1.0",
    "sinon": "^21.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
